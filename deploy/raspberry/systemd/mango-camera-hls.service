[Unit]
Description=M.A.N.G.O/ARGOS CSI Camera HLS Stream
After=network-online.target nginx.service
Wants=network-online.target nginx.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
EnvironmentFile=/etc/mango/raspi.env
ExecStart=/opt/mango/raspberry/scripts/start-camera-hls.sh
Restart=always
RestartSec=4
User=root
WorkingDirectory=/opt/mango/raspberry

# Conservative hardening. Camera access still works because the service runs as root.
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
