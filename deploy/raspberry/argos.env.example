# ARGOS - Raspberry Pi 4B boot/autostart environment
# Copy to: /etc/argos/argos.env
# Edit after first publish: sudo nano /etc/argos/argos.env

ARGOS_MODE=production
ARGOS_PROJECT_NAME=ARGOS
ARGOS_BASE_DIR=/opt/argos
ARGOS_APP_DIR=/opt/argos/app
ARGOS_VENV_DIR=/opt/argos/venv
ARGOS_LOG_DIR=/var/log/argos
ARGOS_RUN_DIR=/run/argos

# Change this to your real ARGOS entrypoint.
# Examples:
#   ARGOS_START_CMD=python3 main.py
#   ARGOS_START_CMD=python3 src/main.py
#   ARGOS_START_CMD=bash start.sh
ARGOS_START_CMD=python3 main.py

ARGOS_REQUIREMENTS_FILE=requirements.txt
ARGOS_INSTALL_PYTHON_DEPS=yes

ARGOS_ENABLE_HOTSPOT=yes
ARGOS_ENABLE_CAMERA=yes
ARGOS_ENABLE_APP=yes
ARGOS_BOOT_DELAY_SEC=8
ARGOS_SYNC_APP=yes
ARGOS_RSYNC_EXCLUDES=.git .venv venv __pycache__ .pytest_cache node_modules dist build .mypy_cache .ruff_cache logs *.pyc

# Optional defaults for future ARGOS hardware modules.
ARGOS_SERIAL_PORT=/dev/ttyACM0
ARGOS_SERIAL_BAUD=115200
ARGOS_FAIL_SAFE_ON_BOOT=yes
ARGOS_REQUIRE_CAMERA=no
ARGOS_REQUIRE_HOTSPOT=no
