# M.A.N.G.O / ARGOS - Raspberry Pi 4B deployment environment
# Copy to: /etc/mango/raspi.env
# Edit before production: sudo nano /etc/mango/raspi.env

PROJECT_NAME=mango
DEVICE_HOSTNAME=mango-pi

# Install/runtime paths
INSTALL_DIR=/opt/mango/raspberry
DATA_DIR=/var/lib/mango
LOG_DIR=/var/log/mango
WEB_ROOT=/var/www/html
STREAM_DIR=/var/www/html/cam

# Camera CSI / NoIR configuration
# Recommended initial mode: 1280x720 @ 24 fps for stable Wi-Fi streaming.
CAM_WIDTH=1280
CAM_HEIGHT=720
CAM_FPS=24
CAM_BITRATE=2500000
CAM_HLS_TIME=1
CAM_HLS_LIST_SIZE=4

# auto = script tries common NoIR tuning files on Raspberry Pi 4/vc4.
# Examples:
#   /usr/share/libcamera/ipa/rpi/vc4/imx219_noir.json  # Camera Module 2 NoIR
#   /usr/share/libcamera/ipa/rpi/vc4/imx708_noir.json  # Camera Module 3 NoIR, if present
CAM_TUNING_FILE=auto

# Extra args are optional. Keep empty unless you know exactly what you need.
# Example: CAM_EXTRA_ARGS="--awb auto --denoise cdn_off"
CAM_EXTRA_ARGS=""

# Hotspot configuration
HOTSPOT_CONN_NAME=MANGO-Hotspot
HOTSPOT_IFACE=wlan0
HOTSPOT_SSID=MANGO_PI_CAM
HOTSPOT_PASSWORD=ChangeMe_MANGO_2026
HOTSPOT_IP4=10.42.0.1/24
HOTSPOT_AUTOSTART=yes

# Web player helper. During install, the script will try to cache hls.js locally.
HLS_JS_URL=https://cdn.jsdelivr.net/npm/hls.js@1/dist/hls.min.js
